#!/bin/bash
# MPI x OpenMP split on 4 nodes (288 cores): ranks/node x threads/rank = 72.
# Submit: qsub -v DIM=3,N=512 scripts/vanda/hybrid_omp.pbs
#PBS -N pcg_hybrid
#PBS -l select=4:ncpus=72
#PBS -l walltime=02:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR"
source scripts/vanda/env.sh
DIM=${DIM:-3}; N=${N:-512}; NODES=4
OUT=results/hybrid_omp_${DIM}d.csv
for RPN in 72 36 18 8 4 2 1; do
  T=$((72 / RPN)); P=$((RPN * NODES))
  export OMP_NUM_THREADS=$T
  # TODO(C): check binding flags for the MPI in nvhpc-hpcx (Open MPI syntax below)
  mpirun -np $P --map-by ppr:${RPN}:node:PE=${T} --bind-to core \
    build/bin/poisson_omp --dim $DIM --n $N --repeat 3 --csv $OUT
done
